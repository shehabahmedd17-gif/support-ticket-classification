# Required by Api.config.LLMSettings
LLM_api_key=your_api_key_here
LLM_model=your_model_name_here

# Optional LLM settings
LLM_base_url=https://api.groq.com/openai/v1
LLM_max_attempts=3
LMM_base_delay=2
LLM_timeout=30

# Required by src.infernce.config
MODEL_NAME=your_huggingface_model_name_here
DEVICE_MAP=auto
TORCH_DTYPE=auto
